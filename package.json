{
  "name": "abap-form-translator",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "ABAP Form Translator - off-stack gate: abaplint + transpiled ABAP Unit tests",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "abaplint",
    "lint:fix": "abaplint --fix",
    "transpile": "rimraf output && abap_transpile",
    "pretest": "npm run transpile",
    "test": "node output/index.mjs",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@abaplint/cli": "^2.120.92",
    "@abaplint/database-sqlite": "^2.14.12",
    "@abaplint/runtime": "^2.14.17",
    "@abaplint/transpiler-cli": "^2.14.17",
    "rimraf": "^6.1.4"
  }
}
