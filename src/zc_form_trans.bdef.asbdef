projection;
strict ( 2 );
use draft;

define behavior for ZC_FORM_TRANS alias Translation
  use etag
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action copyToLanguage;

  // A copy lands as a new draft row next to the source; the list has to
  // refresh so the user sees it without reloading.
  side effects
  {
    action copyToLanguage affects $self;
  }

}