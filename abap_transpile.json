{
  "input_folder": "src",
  "input_filter": [
    "zcl_form_translation.clas",
    "zif_form_translation.intf",
    "zabap_form_trans_msg.msag",
    "zabap_form_trans.tabl",
    "zabap_form_drft.tabl",
    "zabap_form_trans_name.dtel",
    "zabap_form_trans_langu.dtel",
    "zabap_form_trans_field.dtel",
    "zabap_form_trans_descr.dtel",
    "zabap_form_trans_maxlen.dtel",
    "zabap_form_maxlength.doma"
  ],
  "output_folder": "output",
  "libs": [
    {
      "url": "https://github.com/open-abap/open-abap-core"
    },
    {
      "url": "https://github.com/open-abap/open-abap-rap"
    },
    {
      "url": "https://github.com/open-abap/open-abap-bal"
    },
    {
      "url": "https://github.com/open-abap/open-abap-gui"
    },
    {
      "url": "https://github.com/open-abap/open-abap-xco"
    }
  ],
  "write_unit_tests": true,
  "write_source_map": true,
  "options": {
    "ignoreSyntaxCheck": true,
    "addFilenames": true,
    "addCommonJS": true,
    "unknownTypes": "runtimeError",
    "skip": [
      {
        "object": "ZCL_FORM_TRANSLATION",
        "class": "LTC_GET_TRANSLATIONS",
        "method": "CLASS_SETUP"
      },
      {
        "object": "ZCL_FORM_TRANSLATION",
        "class": "LTC_GET_TRANSLATIONS",
        "method": "CLASS_TEARDOWN"
      },
      {
        "object": "ZCL_FORM_TRANSLATION",
        "class": "LTC_GET_TRANSLATIONS",
        "method": "SETUP"
      },
      {
        "object": "ZCL_FORM_TRANSLATION",
        "class": "LTC_GET_TRANSLATIONS",
        "method": "GIVEN_STANDARD_ROWS"
      },
      {
        "object": "ZCL_FORM_TRANSLATION",
        "class": "LTC_GET_TRANSLATIONS",
        "method": "GIVEN_BOTH_LANGS_THEN_TARGET"
      },
      {
        "object": "ZCL_FORM_TRANSLATION",
        "class": "LTC_GET_TRANSLATIONS",
        "method": "GIVEN_GAP_THEN_DEFAULT_LANG"
      },
      {
        "object": "ZCL_FORM_TRANSLATION",
        "class": "LTC_GET_TRANSLATIONS",
        "method": "GIVEN_NO_FALLBACK_THEN_1_ROW"
      },
      {
        "object": "ZCL_FORM_TRANSLATION",
        "class": "LTC_GET_TRANSLATIONS",
        "method": "GIVEN_2ND_CALL_THEN_BUFFERED"
      },
      {
        "object": "ZCL_FORM_TRANSLATION",
        "class": "LTC_GET_TRANSLATIONS",
        "method": "GIVEN_NO_ROWS_THEN_CACHED"
      },
      {
        "object": "ZCL_FORM_TRANSLATION",
        "class": "LTC_GET_TRANSLATIONS",
        "method": "GIVEN_CLEARED_THEN_RELOADS"
      },
      {
        "object": "ZCL_FORM_TRANSLATION",
        "class": "LTC_GET_TRANSLATIONS",
        "method": "GIVEN_LOWER_FORM_THEN_FOUND"
      }
    ]
  }
}
