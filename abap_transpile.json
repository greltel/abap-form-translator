{
  "input_folder": "src",
  "input_filter": [
      "zcl_form_translation.clas",
      "zif_form_translation",
      "zabap_form_trans_msg.msag"
    ],
  "output_folder": "output",
  "libs": [
    {
      "url": "https://github.com/open-abap/open-abap-core"
    },
    {
      "url": "https://github.com/open-abap/open-abap-rap"
    },
    {
      "url": "https://github.com/open-abap/open-abap-bal"
    },
    {
      "url": "https://github.com/open-abap/open-abap-gui"
    },
    {
      "url": "https://github.com/open-abap/open-abap-xco"
    }
  ],
  "write_unit_tests": true,
  "write_source_map": true,
  "options": {
    "ignoreSyntaxCheck": true,
    "addFilenames": true,
    "addCommonJS": true,
    "unknownTypes": "runtimeError"
  }
}
