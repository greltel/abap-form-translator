{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2302-api",
      "folder": "/deps",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "Cloud",
    "errorNamespace": "."
  },
  "rules": {
    "object_naming": {
      "exclude": [],
      "severity": "Error",
      "patternKind": "required",
      "ignoreNames": [],
      "ignorePatterns": [],
      "clas": "^Z(C[LX]|BP)",
      "intf": "^ZIF",
      "prog": "^Z",
      "fugr": "^Z",
      "tabl": "^Z",
      "ttyp": "^Z",
      "dtel": "^Z",
      "doma": "^Z",
      "msag": "^Z",
      "tran": "^Z",
      "enqu": "^EZ",
      "auth": "^Z",
      "pinf": "^Z",
      "idoc": "^Z",
      "xslt": "^Z",
      "ssfo": "^Z",
      "ssst": "^Z",
      "shlp": "^Z"
    },
    "local_class_naming": {
      "exclude": [],
      "severity": "Error",
      "patternKind": "required",
      "ignoreNames": [],
      "ignorePatterns": [],
      "local": "^L.+$",
      "exception": "^LCX_.+$",
      "test": "^L.+$"
    },
    "method_parameter_names": {
      "exclude": [],
      "severity": "Error",
      "patternKind": "forbidden",
      "ignoreNames": [],
      "ignorePatterns": [],
      "ignoreExceptions": true,
      "importing": "^I(V|S|T|O|R|P|I)?_.+$",
      "returning": "^R(V|S|T|O|R|E|P|I)?_.+$",
      "changing": "^C(V|S|T|O|R|P|I)?_.+$",
      "exporting": "^E(V|S|T|O|R|P|I)?_.+$"
    },
    "local_variable_names": {
      "exclude": [],
      "severity": "Error",
      "patternKind": "forbidden",
      "ignoreNames": [],
      "expectedData": "^L(V|T|S|O|R)?_.+$",
      "expectedConstant": "^(L?C)_.+$",
      "expectedFS": "^<FS_.+>$|^<L(V|S|T)?_.+>$"
    },
    "class_attribute_names": {
      "exclude": [],
      "severity": "Error",
      "patternKind": "forbidden",
      "ignoreNames": [],
      "statics": "^[GS](V|T|S|O|R|C)?_.+$",
      "instance": "^M(V|T|S|O|R|C)?_.+$"
    },
    "selection_screen_naming": {
      "exclude": [],
      "severity": "Error",
      "patternKind": "required",
      "ignoreNames": [],
      "ignorePatterns": [],
      "parameter": "^P_.+$",
      "selectOption": "^S_.+$",
      "screenElement": "^SC_.+$"
    },
    "prefer_inline": true,
    "prefer_returning_to_exporting": true,
    "prefer_xsdbool": true,
    "prefer_is_not": true,
    "prefer_raise_exception_new": true,
    "obsolete_statement": true,
    "empty_statement": true,
    "if_in_if": true,
    "max_one_statement": true,
    "space_before_colon": true,
    "whitespace_end": true,
    "contains_tab": true,
    "7bit_ascii": true,
    "pragma_style": true,
    "exporting": true,
    "unused_variables": true,
    "indentation": true,
    "keyword_case": {
      "style": "upper"
    },
    "line_length": {
      "length": 120
    },
    "method_length": {
      "statements": 40
    },
    "cyclomatic_complexity": {
      "max": 10
    },
    "sequential_blank": {
      "lines": 3
    },
    "avoid_use": {
      "define": true,
      "describe": true,
      "statics": true,
      "defaultKey": true,
      "break": true
    }
  }
}
